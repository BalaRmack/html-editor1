{
  "name": "verdant-launcher",
  "version": "1.2.0",
  "description": "Verdant Launcher — premium Minecraft launcher",
  "main": "./out/main/index.js",
  "author": "BalaRmack",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "build:only": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.installer.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "preview:ui": "vite --config vite.preview.config.ts --host 0.0.0.0 --port 4173",
    "package": "npm run build:payload && npm run package:bootstrapper",
    "package:dir": "npm run build:only && electron-builder --win --dir",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "test:all": "vitest run --config vitest.config.ts && vitest run --config vitest.ui.config.ts",
    "build:installer": "electron-vite build --config electron.vite.installer.config.ts",
    "build:payload": "npm run build:only && electron-builder --win --dir --publish never && node scripts/make-payload.mjs",
    "package:bootstrapper": "npm run build:installer && electron-builder --win --x64 --config electron-builder.installer.yml --publish never"
  },
  "dependencies": {
    "@xmcl/core": "2.15.1",
    "@xmcl/installer": "6.0.0",
    "@xmcl/task": "4.1.1",
    "adm-zip": "^0.5.16",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "clsx": "^2.1.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "framer-motion": "^14.9.0",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.66.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.107.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  }
}
